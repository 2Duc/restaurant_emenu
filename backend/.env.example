# Sao chép thành backend/.env rồi điền giá trị thật
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (BRD §8) — hoặc dùng DATABASE_URL=postgresql://user:pass@host:5432/e_menu
DB_NAME=e_menu
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis cho Django Channels khi chạy nhiều tiến trình (để trống = InMemory)
REDIS_URL=

# VNPay SANDBOX (BR-11) — không dùng tài khoản thật
# vnpay | mock (cổng giả lập để demo offline). Để trống: mock nếu thiếu khoá VNPay, ngược lại vnpay
PAYMENT_GATEWAY_MODE=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET_KEY=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://127.0.0.1:8000/api/payments/vnpay-return/
VNPAY_IPN_URL=http://127.0.0.1:8000/api/payments/vnpay-ipn/
VNPAY_BANK_CODE=
FRONTEND_RETURN_URL=http://localhost:5173/payment-result
FRONTEND_BASE_URL=http://localhost:5173
# Địa chỉ ổn định cho link trong QR in ra (tên miền / IP LAN cố định). Trống = dùng FRONTEND_BASE_URL. Đổi địa chỉ = phải in lại QR.
PUBLIC_BASE_URL=
MEDIA_ROOT=
