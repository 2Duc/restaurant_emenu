# Sao chép thành .env (cùng thư mục docker-compose.yml)
# IP LAN của máy (ipconfig -> IPv4 của Wi-Fi/Ethernet). Đổi IP => docker compose up -d --build (VITE_* là build-arg)
HOST_IP=localhost
# Cổng web (đổi nếu 8080 đã bị chiếm, vd. PEM/Apache của PostgreSQL)
FRONTEND_PORT=8080
SEED_DEMO_PASSWORD=
# Số reverse proxy tin cậy trước backend (RATE-01). Compose nối thẳng: 0
NUM_PROXIES=0
PAYMENT_GATEWAY_MODE=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET_KEY=
